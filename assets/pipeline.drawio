  ════════════════════════════════════════════════════════════════════ -->
  <diagram name="End-to-End Pipeline">
    <mxGraphModel background="#ffffff" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
