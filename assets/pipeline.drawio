  <diagram name="Machine Translation Workflow">
    <mxGraphModel background="#ffffff" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
