          <mxGeometry x="320" y="40" width="150" height="55" as="geometry"/>
        </mxCell>

        <!-- branch left: many-to-many -->
        <mxCell id="p3r1-m2m" value="Many-to-Many" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
