        <mxCell id="r1-main" value="9 Countries · 7 Languages · Social &amp; Mainstream Media" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
