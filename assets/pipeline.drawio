        <mxCell id="1" parent="0"/>

        <!-- ── ROW 1 · Data Collection (y=40) ──────────────────────── -->
        <mxCell id="r1-label" value="Data Collection" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="42" width="160" height="40" as="geometry"/>
