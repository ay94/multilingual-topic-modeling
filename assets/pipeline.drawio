          <mxGeometry x="180" y="270" width="145" height="50" as="geometry"/>
        </mxCell>

        <!-- branch right: language pair -->
        <mxCell id="p3r1-pair" value="Language Pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="465" y="160" width="145" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3r1-hels" value="Helsinki-NLP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="465" y="270" width="145" height="50" as="geometry"/>
        </mxCell>

        <!-- detect → m2m -->
        <mxCell id="p3a1-dm" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r1-detect" target="p3r1-m2m" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- detect → pair -->
        <mxCell id="p3a1-dp" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r1-detect" target="p3r1-pair" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- m2m → mbart -->
        <mxCell id="p3a1-mm" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r1-m2m" target="p3r1-mbart" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- pair → helsinki -->
        <mxCell id="p3a1-ph" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r1-pair" target="p3r1-hels" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- mbart → row2 -->
        <mxCell id="p3a1-mb2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r1-mbart" target="p3r2-trans" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- helsinki → row2 -->
        <mxCell id="p3a1-hb2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r1-hels" target="p3r2-trans" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── ROW 2 · Batched Translation (y=385) ───────────────── -->
        <mxCell id="p3r2-label" value="Batched Translation" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="382" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3r2-trans" value="Translate Iterator&#xa;batch_size · src_lang · tgt_lang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="378" width="230" height="60" as="geometry"/>
        </mxCell>

        <!-- arrow row2 → row3 -->
        <mxCell id="p3a2-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r2-trans" target="p3r3-bert" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── ROW 3 · Quality Validation (y=508) ─────────────────── -->
        <mxCell id="p3r3-label" value="Quality Validation" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="510" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3r3-bert" value="BERTScore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="508" width="140" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p3r3-prf" value="Precision · Recall · F1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="370" y="508" width="165" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p3r3-human" value="Human Spot-Check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="508" width="155" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p3a3-bp" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r3-bert" target="p3r3-prf" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- arrow row3 → row4 -->
        <mxCell id="p3a3-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r3-prf" target="p3r4-thresh" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── ROW 4 · Threshold Check (y=630) ───────────────────── -->
        <mxCell id="p3r4-label" value="Threshold Check" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="635" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3r4-thresh" value="Score ≥ threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="623" width="170" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="p3r4-yes" value="Translated Corpus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="635" width="155" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p3r4-no" value="Re-translate / Fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="635" width="155" height="55" as="geometry"/>
        </mxCell>

        <!-- thresh → yes -->
        <mxCell id="p3a4-ty" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r4-thresh" target="p3r4-yes" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3a4-ty-lbl" value="Yes" style="text;html=1;fontSize=11;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="492" y="638" width="40" height="20" as="geometry"/>
        </mxCell>
        <!-- thresh → no -->
        <mxCell id="p3a4-tn" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r4-thresh" target="p3r4-no" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3a4-tn-lbl" value="No" style="text;html=1;fontSize=11;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="265" y="638" width="30" height="20" as="geometry"/>
        </mxCell>
        <!-- no → loops back to translate iterator (dashed) -->
        <mxCell id="p3a4-loop" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" source="p3r4-no" target="p3r2-trans" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="100" y="662"/>
              <mxPoint x="100" y="408"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- yes → row5 -->
        <mxCell id="p3a4-5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p3r4-yes" target="p3r5-out" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── ROW 5 · Output (y=760) ──────────────────────────────── -->
        <mxCell id="p3r5-label" value="Output" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="762" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3r5-out" value="Multilingual Corpus → English" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="760" width="350" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p3r5-note" value="ar_AR · ur_PK · tr_TR · id_ID · fa_IR · hi_IN" style="text;html=1;align=left;fontStyle=2;fontSize=10;fontColor=#888888;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="180" y="820" width="310" height="22" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ═══════════════════════════════════════════════════════════════
       PAGE 4 — SetFit Evaluation Workflow
  ════════════════════════════════════════════════════════════════════ -->
  <diagram name="SetFit Evaluation Workflow">
    <mxGraphModel background="#ffffff" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ── ROW 1 · Cluster Sampling (y=40) ────────────────────── -->
        <mxCell id="p4r1-label" value="Cluster Sampling" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="42" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p4r1-cluster" value="BERTopic Cluster Output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="40" width="175" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r1-sample" value="Sample Cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="405" y="40" width="140" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r1-pos" value="Positive Examples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="155" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4r1-neg" value="Negative Examples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="78" width="155" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4a1-cs" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r1-cluster" target="p4r1-sample" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4a1-sp" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r1-sample" target="p4r1-pos" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4a1-sn" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r1-sample" target="p4r1-neg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- pos + neg → row2 trainer -->
        <mxCell id="p4a1-2p" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r1-pos" target="p4r2-trainer" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4a1-2n" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r1-neg" target="p4r2-trainer" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── ROW 2 · SetFit Training (y=200) ───────────────────── -->
        <mxCell id="p4r2-label" value="SetFit Training" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="202" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p4r2-backbone" value="Sentence Transformer Backbone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="200" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r2-trainer" value="SetFitTrainer&#xa;num_epochs · batch_size · seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="200" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4a2-bt" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r2-backbone" target="p4r2-trainer" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- arrow row2 → row3 -->
        <mxCell id="p4a2-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r2-trainer" target="p4r3-cv" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── ROW 3 · Cross-Validation (y=330) ───────────────────── -->
        <mxCell id="p4r3-label" value="Cross-Validation" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="332" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p4r3-cv" value="10-Fold CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="330" width="140" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r3-metrics" value="Accuracy · Precision · Recall · F1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="330" width="215" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r3-note" value="mean F1 0.85 · mean Acc 0.86" style="text;html=1;align=left;fontStyle=2;fontSize=10;fontColor=#888888;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="370" y="390" width="215" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="p4a3-cm" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r3-cv" target="p4r3-metrics" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- arrow row3 → row4 -->
        <mxCell id="p4a3-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r3-metrics" target="p4r4-report" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── ROW 4 · Evaluation (y=475) ────────────────────────── -->
        <mxCell id="p4r4-label" value="Evaluation" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="477" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p4r4-report" value="Classification Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="475" width="165" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r4-conf" value="Confusion Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="365" y="475" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r4-dict" value="Metrics Dict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="535" y="475" width="140" height="55" as="geometry"/>
        </mxCell>

        <!-- arrow row4 → row5 -->
        <mxCell id="p4a4-5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r4-conf" target="p4r5-annotate" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── ROW 5 · Apply to Corpus (y=605) ───────────────────── -->
        <mxCell id="p4r5-label" value="Apply to Corpus" style="text;html=1;align=right;fontStyle=3;fontColor=#555555;fontSize=13;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="607" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p4r5-annotate" value="Annotate Full Cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="605" width="165" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r5-refined" value="Refined Cluster Labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="395" y="605" width="165" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4r5-next" value="Refined embeddings →&#xa;next BERTopic layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="605" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p4a5-ar" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r5-annotate" target="p4r5-refined" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4a5-rn" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;" edge="1" source="p4r5-refined" target="p4r5-next" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
